# Google search via Serper: https://serper.dev/
SERPER_API_KEY=your_serper_api_key_here

# Output stays inside this game project.
OUTPUT_DIR=./output

# Any OpenAI-compatible API for generation and translation.
LLM_API_KEY=your_llm_api_key_here
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=your_model_here
LLM_TEMPERATURE=0.5
LLM_MAX_TOKENS=24576
LLM_TIMEOUT=300
LLM_RETRY_ATTEMPTS=2
LLM_RETRY_DELAY=5

# Generation and translation concurrency.
GENERATE_BATCH_SIZE=20
GENERATE_CONCURRENT_LIMIT=5
TRANSLATE_BATCH_SIZE=10
TRANSLATE_BATCH_DELAY=1

# YouTube collection.
YOUTUBE_INITIAL_SEARCH_RESULTS=3
YOUTUBE_MAX_RESULTS_AFTER_FILTER=2
YOUTUBE_MAX_DURATION=3600
YOUTUBE_EXTRACT_TOP_K=2
YOUTUBE_SEARCH_WORKERS=6
YOUTUBE_TRANSCRIPT_WORKERS=8

# Free local extraction with Trafilatura. No Jina key is used.
WEB_SEARCH_TOP_N=10
WEB_EXTRACT_TOP_K=2
WEB_SEARCH_CONCURRENCY=4
WEB_EXTRACT_RPM=45
WEB_EXTRACT_CONCURRENCY=4
WEB_EXTRACT_TIMEOUT=45
WEB_EXTRACT_RETRIES=3
# WEB_EXTRACT_USER_AGENT=Mozilla/5.0 (compatible; GameWikiResearch/1.0)

# Optional proxy for YouTube or sites that block the current IP.
USE_PROXY=false
# TUNNEL_HOST=
# TUNNEL_PORT=
# TUNNEL_USER=
# TUNNEL_PASS=
# USE_PROXY_FOR_SEARCH=false
# USE_PROXY_FOR_EXTRACT=false

SEARCH_MAX_RETRIES=3
SEARCH_RETRY_DELAY=2
BLOCKED_DOMAINS=fandom.com,wiki.gg,fextralife.com,youtube.com,youtu.be
