# Recommended for deployment. Bare domains, surrounding quotes, and Markdown links are normalized.
NEXT_PUBLIC_SITE_URL=https://your-new-domain.example

# Optional server-side alias. NEXT_PUBLIC_SITE_URL takes precedence when both are set.
# SITE_URL=https://your-new-domain.example

# Adsterra banner keys — copy to .env.local and fill in your keys.
# Then run pnpm ads:sync (also runs automatically before dev/build).
# See public/ads/README.md.

NEXT_PUBLIC_AD_MOBILE_320X50=
NEXT_PUBLIC_AD_SIDEBAR_160X600=
NEXT_PUBLIC_AD_SIDEBAR_160X300=
NEXT_PUBLIC_AD_BANNER_300X250=
NEXT_PUBLIC_AD_BANNER_728X90=
NEXT_PUBLIC_AD_BANNER_468X60=
NEXT_PUBLIC_AD_NATIVE_BANNER=
NEXT_PUBLIC_AD_NATIVE_SCRIPT=
